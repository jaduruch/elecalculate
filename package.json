{
	"name": "elecalculate",
	"version": "2.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
		"build": "vite build && bun scripts/postbuild.ts",
		"start": "bun server.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test tests/unit",
		"test:e2e": "playwright test",
		"migrate:source": "bun scripts/migrate-source.ts",
		"db:generate": "drizzle-kit generate",
		"verify": "bun run test && bun run build && bun run typecheck && bun run test:e2e && bun run test:webkit",
		"test:webkit": "playwright test --config playwright.webkit.config.ts",
		"verify:live": "bun scripts/verify-live.ts"
	},
	"dependencies": {
		"@electric-sql/pglite": "0.5.11",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"dompurify": "3.4.17",
		"drizzle-orm": "1.0.0-rc.5",
		"katex": "0.19.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"three": "0.186.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@babel/generator": "8.0.6",
		"@babel/parser": "8.0.8",
		"@babel/traverse": "8.0.7",
		"@biomejs/biome": "2.6.2",
		"@playwright/test": "1.64.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "1.4.4",
		"@types/katex": "0.16.8",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"drizzle-kit": "1.0.0-rc.5",
		"parse5": "8.0.1",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.5"
	}
}
