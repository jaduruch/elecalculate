{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["vite/client", "bun"],
		"paths": {
			"~/*": ["./src/*"]
		},
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.js",
		"vite.config.ts",
		"server.ts",
		"drizzle.config.ts"
	]
}
